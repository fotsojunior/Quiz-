rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && isVerified() && request.auth.uid == userId;
    }

    function isCountryCode(val) {
      return val is string && val.size() == 2 && val.matches('^[A-Z]{2}$');
    }

    function isOptionalCountryCode(val) {
      return val is string && (val == '' || (val.size() == 2 && val.matches('^[A-Z]{2}$')));
    }

    function isCategoryStatEntry(stat) {
      return stat is map
        && stat.keys().hasAll(['played', 'won', 'points'])
        && stat.keys().hasOnly(['played', 'won', 'points'])
        && stat.played is int && stat.played >= 0 && stat.played <= 1000000
        && stat.won is int && stat.won >= 0 && stat.won <= 1000000
        && stat.points is int && stat.points >= -10000000 && stat.points <= 10000000;
    }

    function isValidCategoryStatsMap(stats) {
      return stats is map
        && stats.keys().hasAll(['enigma', 'logic', 'focus', 'speed', 'creation', 'riddle'])
        && stats.keys().hasOnly(['enigma', 'logic', 'focus', 'speed', 'creation', 'riddle'])
        && isCategoryStatEntry(stats.enigma)
        && isCategoryStatEntry(stats.logic)
        && isCategoryStatEntry(stats.focus)
        && isCategoryStatEntry(stats.speed)
        && isCategoryStatEntry(stats.creation)
        && isCategoryStatEntry(stats.riddle);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'userId', 'syncCode', 'playerName', 'countryCode', 'rivalCode',
          'userPoints', 'wins', 'losses', 'currentStreak', 'bestStreak',
          'answeredCount', 'solvedIds', 'categoryStats', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'syncCode', 'playerName', 'countryCode', 'rivalCode',
          'userPoints', 'wins', 'losses', 'currentStreak', 'bestStreak',
          'answeredCount', 'solvedIds', 'categoryStats', 'createdAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.syncCode is string && data.syncCode.size() >= 2 && data.syncCode.size() <= 24
        && data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 24
        && isCountryCode(data.countryCode)
        && isOptionalCountryCode(data.rivalCode)
        && data.userPoints is int && data.userPoints >= 0 && data.userPoints <= 100000000
        && data.wins is int && data.wins >= 0 && data.wins <= 1000000
        && data.losses is int && data.losses >= 0 && data.losses <= 1000000
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 1000000
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 1000000
        && data.answeredCount is int && data.answeredCount >= 0 && data.answeredCount <= 1000000
        && data.solvedIds is list && data.solvedIds.size() <= 2000
        && (data.solvedIds.size() == 0 || data.solvedIds[0] is int)
        && isValidCategoryStatsMap(data.categoryStats)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryEntry(data, userId, entryId) {
      return data.keys().hasAll([
          'id', 'userId', 'challengeId', 'title', 'category', 'difficulty',
          'won', 'userPointsDelta', 'countryDelta', 'countryCode', 'rivalCode',
          'mode', 'timestamp', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'challengeId', 'title', 'category', 'difficulty',
          'won', 'userPointsDelta', 'countryDelta', 'countryCode', 'rivalCode',
          'mode', 'timestamp', 'createdAt'
        ])
        && data.id is string && data.id == entryId && isValidId(data.id)
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.challengeId is int && data.challengeId >= 1 && data.challengeId <= 12500
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category in ['enigma', 'logic', 'focus', 'speed', 'creation', 'riddle']
        && data.difficulty is string && data.difficulty in ['facile', 'moyen', 'difficile', 'maitre']
        && data.won is bool
        && data.userPointsDelta is int && data.userPointsDelta >= -500 && data.userPointsDelta <= 500
        && data.countryDelta is int && data.countryDelta >= -500 && data.countryDelta <= 500
        && isCountryCode(data.countryCode)
        && isOptionalCountryCode(data.rivalCode)
        && data.mode is string && data.mode in ['solo', 'duel', 'shared']
        && data.timestamp is int && data.timestamp > 0
        && data.createdAt is timestamp;
    }

    function isValidSharedChallenge(data, shareId) {
      return data.keys().hasAll([
          'shareId', 'creatorUserId', 'challengeId', 'creatorName',
          'creatorCountryCode', 'creatorWon', 'creatorFinished',
          'creatorPointsDelta', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'shareId', 'creatorUserId', 'challengeId', 'creatorName',
          'creatorCountryCode', 'creatorWon', 'creatorFinished',
          'creatorPointsDelta', 'createdAt', 'updatedAt'
        ])
        && data.shareId is string && data.shareId == shareId && isValidId(data.shareId)
        && data.creatorUserId is string && isValidId(data.creatorUserId)
        && data.challengeId is int && data.challengeId >= 1 && data.challengeId <= 12500
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 24
        && isCountryCode(data.creatorCountryCode)
        && data.creatorWon is bool
        && data.creatorFinished is bool
        && data.creatorPointsDelta is int && data.creatorPointsDelta >= -500 && data.creatorPointsDelta <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{userId} (Owner-only PII & Progression) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update player identity / rival metadata
          incoming().diff(existing()).affectedKeys().hasOnly([
            'syncCode', 'playerName', 'countryCode', 'rivalCode', 'updatedAt'
          ])
          ||
          // Action: Record challenge/duel progression or sync merge
          incoming().diff(existing()).affectedKeys().hasOnly([
            'syncCode', 'playerName', 'countryCode', 'rivalCode',
            'userPoints', 'wins', 'losses', 'currentStreak', 'bestStreak',
            'answeredCount', 'solvedIds', 'categoryStats', 'updatedAt'
          ])
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      // --- Subcollection: /users/{userId}/history/{entryId} ---
      match /history/{entryId} {
        allow get: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        // Cost-optimization clause: NO get()/exists() in allow list
        allow list: if isSignedIn()
          && isVerified()
          && request.auth.uid == userId
          && existing().userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && isValidHistoryEntry(incoming(), userId, entryId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        allow update: if false;

        allow delete: if isValidId(userId)
          && isValidId(entryId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;
      }
    }

    // --- Collection: /sharedChallenges/{shareId} ---
    match /sharedChallenges/{shareId} {
      allow get: if isValidId(shareId)
        && isSignedIn()
        && isVerified()
        && existing().creatorUserId == request.auth.uid;

      allow list: if isSignedIn()
        && isVerified()
        && existing().creatorUserId == request.auth.uid;

      allow create: if isValidId(shareId)
        && isSignedIn()
        && isVerified()
        && isValidSharedChallenge(incoming(), shareId)
        && incoming().creatorUserId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(shareId)
        && isSignedIn()
        && isVerified()
        && isValidSharedChallenge(incoming(), shareId)
        && existing().creatorUserId == request.auth.uid
        && incoming().creatorUserId == existing().creatorUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().creatorFinished == false
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'creatorWon', 'creatorFinished', 'creatorPointsDelta', 'updatedAt'
        ]);

      allow delete: if isValidId(shareId)
        && isSignedIn()
        && isVerified()
        && existing().creatorUserId == request.auth.uid;
    }

    function isValidDuelRoom(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'status', 'challengeIds', 'currentRound',
          'hostUserId', 'hostName', 'hostCountryCode', 'hostScore', 'hostRoundDone', 'hostLastCorrect',
          'guestUserId', 'guestName', 'guestCountryCode', 'guestScore', 'guestRoundDone', 'guestLastCorrect',
          'winnerUserId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'status', 'challengeIds', 'currentRound',
          'hostUserId', 'hostName', 'hostCountryCode', 'hostScore', 'hostRoundDone', 'hostLastCorrect',
          'guestUserId', 'guestName', 'guestCountryCode', 'guestScore', 'guestRoundDone', 'guestLastCorrect',
          'winnerUserId', 'createdAt', 'updatedAt'
        ])
        && data.roomId is string && data.roomId == roomId && data.roomId.size() >= 4 && data.roomId.size() <= 16 && data.roomId.matches('^[A-Z0-9]+$')
        && data.status is string && data.status in ['waiting', 'playing', 'finished']
        && data.challengeIds is list && data.challengeIds.size() == 5 && data.challengeIds[0] is int
        && data.currentRound is int && data.currentRound >= 0 && data.currentRound <= 4
        && data.hostUserId is string && isValidId(data.hostUserId)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 24
        && isCountryCode(data.hostCountryCode)
        && data.hostScore is int && data.hostScore >= 0 && data.hostScore <= 10000
        && data.hostRoundDone is bool
        && data.hostLastCorrect is bool
        && data.guestUserId is string && (data.guestUserId == '' || isValidId(data.guestUserId))
        && data.guestName is string && data.guestName.size() <= 24
        && isOptionalCountryCode(data.guestCountryCode)
        && data.guestScore is int && data.guestScore >= 0 && data.guestScore <= 10000
        && data.guestRoundDone is bool
        && data.guestLastCorrect is bool
        && data.winnerUserId is string && (data.winnerUserId == '' || isValidId(data.winnerUserId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /duelRooms/{roomId} ---
    match /duelRooms/{roomId} {
      allow get: if isValidId(roomId)
        && isSignedIn()
        && isVerified()
        && (
          existing().status == 'waiting' ||
          existing().hostUserId == request.auth.uid ||
          existing().guestUserId == request.auth.uid
        );

      allow list: if isSignedIn()
        && isVerified()
        && (
          existing().hostUserId == request.auth.uid ||
          existing().guestUserId == request.auth.uid
        );

      allow create: if isValidId(roomId)
        && isSignedIn()
        && isVerified()
        && isValidDuelRoom(incoming(), roomId)
        && incoming().hostUserId == request.auth.uid
        && incoming().guestUserId == ''
        && incoming().status == 'waiting'
        && incoming().winnerUserId == ''
        && incoming().currentRound == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(roomId)
        && isSignedIn()
        && isVerified()
        && isValidDuelRoom(incoming(), roomId)
        && existing().status != 'finished'
        && incoming().roomId == existing().roomId
        && incoming().hostUserId == existing().hostUserId
        && incoming().challengeIds == existing().challengeIds
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Guest joins a waiting room
          (
            existing().status == 'waiting' &&
            existing().guestUserId == '' &&
            request.auth.uid != existing().hostUserId &&
            incoming().guestUserId == request.auth.uid &&
            incoming().guestName.size() >= 1 &&
            isCountryCode(incoming().guestCountryCode) &&
            incoming().status == 'playing' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guestUserId', 'guestName', 'guestCountryCode', 'status', 'updatedAt'
            ])
          )
          ||
          // Action: Host submits round outcome / advances round
          (
            existing().status == 'playing' &&
            existing().hostUserId == request.auth.uid &&
            existing().hostRoundDone == false &&
            incoming().guestUserId == existing().guestUserId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostScore', 'hostRoundDone', 'hostLastCorrect',
              'guestRoundDone', 'currentRound', 'status', 'winnerUserId', 'updatedAt'
            ])
          )
          ||
          // Action: Guest submits round outcome / advances round
          (
            existing().status == 'playing' &&
            existing().guestUserId == request.auth.uid &&
            existing().guestRoundDone == false &&
            incoming().guestUserId == existing().guestUserId &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guestScore', 'guestRoundDone', 'guestLastCorrect',
              'hostRoundDone', 'currentRound', 'status', 'winnerUserId', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(roomId)
        && isSignedIn()
        && isVerified()
        && existing().hostUserId == request.auth.uid;
    }
  }
}
